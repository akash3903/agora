MONGO_URI=mongodb://127.0.0.1:27017/agora
PORT=3000
# Philosophers with at least this many Wikipedia language editions (higher = fewer, more famous). 8 gives a few thousand.
MIN_SITELINKS=8
# Optional: only ingest the N most notable philosophers' books per run
BOOK_LIMIT=500
# Hindi text is machine-translated on first read, then cached. Any LibreTranslate-compatible server works.
TRANSLATE_URL=http://127.0.0.1:5000/translate
TRANSLATE_KEY=
